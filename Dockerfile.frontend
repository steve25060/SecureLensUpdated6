# SecureLens Next.js frontend for Railway

FROM node:20-alpine AS builder
WORKDIR /app

COPY . .
RUN npm install -g pnpm@10
RUN pnpm install --frozen-lockfile
RUN cd apps/frontend && pnpm run build

FROM node:20-alpine
WORKDIR /app/apps/frontend

RUN npm install -g pnpm@10

COPY --from=builder /app/apps/frontend/.next ./.next
COPY --from=builder /app/apps/frontend/public ./public
COPY --from=builder /app/apps/frontend/package.json ./package.json
COPY --from=builder /app/apps/frontend/next.config.js ./next.config.js
COPY --from=builder /app/apps/frontend/node_modules ./node_modules
COPY --from=builder /app/node_modules /app/node_modules

ENV NODE_ENV=production

EXPOSE 3000

CMD ["pnpm", "start"]
