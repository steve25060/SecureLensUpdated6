# ═══════════════════════════════════════════════════════════════════════════════
# PRODUCTION - Backend (Railway)
# URL: https://scintillating-strength-production-de89.up.railway.app/api
# ═══════════════════════════════════════════════════════════════════════════════

# Environment
NODE_ENV=production
PORT=8080

# Backend URL (for OAuth and redirects)
BACKEND_URL=https://securelens-backend-o213.onrender.com
FRONTEND_URL=https://securelens-frontend.onrender.com
FRONTEND_ORIGIN=https://securelens-frontend.onrender.com

# ─────────────────────────────────────────────────────────────
# GitHub OAuth (Loaded from Render Environment Variables)
# ─────────────────────────────────────────────────────────────
GITHUB_CLIENT_ID=${GITHUB_CLIENT_ID}
GITHUB_CLIENT_SECRET=${GITHUB_CLIENT_SECRET}
GITHUB_CALLBACK_URL=https://securelens-backend-o213.onrender.com/api/auth/github/callback

# ─────────────────────────────────────────────────────────────
# Google OAuth (Loaded from Render Environment Variables)
# ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=${GOOGLE_CLIENT_ID}
GOOGLE_CLIENT_SECRET=${GOOGLE_CLIENT_SECRET}
GOOGLE_CALLBACK_URL=https://securelens-backend-o213.onrender.com/api/auth/google/callback

# ─────────────────────────────────────────────────────────────
# Logging
# ─────────────────────────────────────────────────────────────
LOG_LEVEL=warn
ENABLE_PRETTY_LOGS=false

# ─────────────────────────────────────────────────────────────
# Security Scanners (Production enabled)
# ─────────────────────────────────────────────────────────────
SCANNER_TIMEOUT=300000
NUCLEI_ENABLED=true
TRIVY_ENABLED=true
ZAP_ENABLED=false
SEMGREP_ENABLED=true
GITLEAKS_ENABLED=true
NMAP_ENABLED=false
WHATWEB_ENABLED=true
TESTSSL_ENABLED=true

# ─────────────────────────────────────────────────────────────
# Worker Configuration
# ─────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=10
WORKER_TIMEOUT=600000
WORKER_PROCESS_INTERVAL=5000
