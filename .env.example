# SecureLens environment reference

# Local development
NODE_ENV=development
PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000
FRONTEND_ORIGIN=http://localhost:3000

# PostgreSQL
DATABASE_URL=postgresql://securelens:securelens@localhost:5432/securelens

# Redis is optional in the current production flow.
# REDIS_URL=redis://localhost:6379

# Authentication
JWT_SECRET=replace_with_a_random_secret_at_least_32_bytes
JWT_EXPIRATION=24h
ENABLE_DEMO_AUTH=false
NEXT_PUBLIC_ENABLE_DEMO_AUTH=false

# OAuth (optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4000/api/auth/github/callback

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# AI providers (optional)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
CLAUDE_API_KEY=
DEEPSEEK_API_KEY=
OLLAMA_BASE_URL=

# Logging
LOG_LEVEL=debug
ENABLE_PRETTY_LOGS=true

# Railway production example
# Railway injects PORT automatically; do not pin it.
# RAILWAY_DOCKERFILE_PATH=Dockerfile.backend          # backend service
# RAILWAY_DOCKERFILE_PATH=Dockerfile.frontend         # frontend service
# BACKEND_URL=https://web-production-e3c1e.up.railway.app
# NEXT_PUBLIC_BACKEND_URL=https://web-production-e3c1e.up.railway.app
# NEXT_PUBLIC_API_URL=/api
# FRONTEND_URL=https://web-production-13bf9.up.railway.app
# FRONTEND_ORIGIN=https://web-production-13bf9.up.railway.app
# NEXT_PUBLIC_APP_URL=https://web-production-13bf9.up.railway.app
