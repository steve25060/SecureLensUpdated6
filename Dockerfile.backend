# SecureLens backend + native scanner runtime for Railway

FROM golang:alpine AS scanner-builder
RUN apk add --no-cache git
RUN go install github.com/projectdiscovery/dnsx/cmd/dnsx@latest \
 && go install github.com/projectdiscovery/subfinder/v2/cmd/subfinder@latest \
 && go install github.com/projectdiscovery/httpx/cmd/httpx@latest \
 && go install github.com/projectdiscovery/katana/cmd/katana@latest \
 && go install github.com/projectdiscovery/nuclei/v3/cmd/nuclei@latest

FROM node:20-alpine AS builder
WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps ./apps
COPY packages ./packages

RUN npm install -g pnpm@10
RUN pnpm install --frozen-lockfile
RUN cd apps/backend && pnpm run build

FROM node:20-alpine
WORKDIR /app

RUN npm install -g pnpm@10 \
 && apk add --no-cache \
      bash \
      bind-tools \
      ca-certificates \
      curl \
      git \
      nmap \
      openssl \
      postgresql-client \
      ruby

COPY --from=scanner-builder /go/bin/dnsx /usr/local/bin/dnsx
COPY --from=scanner-builder /go/bin/subfinder /usr/local/bin/subfinder
COPY --from=scanner-builder /go/bin/httpx /usr/local/bin/httpx
COPY --from=scanner-builder /go/bin/katana /usr/local/bin/katana
COPY --from=scanner-builder /go/bin/nuclei /usr/local/bin/nuclei

RUN git clone --depth 1 https://github.com/urbanadventurer/WhatWeb.git /opt/whatweb \
 && chmod +x /opt/whatweb/whatweb \
 && ln -s /opt/whatweb/whatweb /usr/local/bin/whatweb \
 && git clone --depth 1 https://github.com/drwetter/testssl.sh.git /opt/testssl.sh \
 && chmod +x /opt/testssl.sh/testssl.sh \
 && ln -s /opt/testssl.sh/testssl.sh /usr/local/bin/testssl

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY --from=builder /app/apps/backend/dist ./apps/backend/dist
COPY --from=builder /app/apps/backend/package.json ./apps/backend/
COPY --from=builder /app/apps/backend/prisma ./apps/backend/prisma
COPY --from=builder /app/apps/backend/prisma.config.ts ./apps/backend/prisma.config.ts
COPY --from=builder /app/apps/backend/scripts ./apps/backend/scripts
COPY --from=builder /app/apps/backend/node_modules ./apps/backend/node_modules
COPY --from=builder /app/packages ./packages
COPY --from=builder /app/node_modules ./node_modules

ENV NODE_ENV=production
ENV PORT=3000

RUN addgroup -g 1001 -S nodejs \
 && adduser -S -D -h /home/nestjs -u 1001 -G nodejs nestjs \
 && mkdir -p /home/nestjs \
 && chown -R nestjs:nodejs /home/nestjs

USER nestjs

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=5 \
  CMD node -e "require('http').get('http://localhost:'+(process.env.PORT||3000)+'/health',r=>{if(r.statusCode!==200)process.exit(1)}).on('error',()=>process.exit(1))"

EXPOSE 3000

# Migrations are idempotent and run before NestJS starts.
CMD ["sh", "-c", "cd /app/apps/backend && pnpm run prisma:deploy && exec node dist/main.js"]
